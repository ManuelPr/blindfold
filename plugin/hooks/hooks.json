{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "blindfold hook session-start" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "blindfold hook post-tool-use" }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          { "type": "command", "command": "blindfold hook message-display" }
        ]
      }
    ]
  }
}
